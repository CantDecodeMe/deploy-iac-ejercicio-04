# =====================================================================
# Ejercicio 04 -- libros-ms: plantilla de configuracion
# =====================================================================
# Copia este archivo a .env y rellena los valores. El .env real NUNCA se
# versiona, se publica en el reporte ni se sube a ubiquitous.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Para generar secretos decentes:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# =====================================================================

# --- PostgreSQL --------------------------------------------------------
# Se conecta al Postgres del monolito (Ejercicio 02) con la cuenta de
# servicio de minimo privilegio, no con la cuenta duena.
PGHOST=libreria-db-1
PGPORT=5432
PGDATABASE=libreria
PGUSER=libros_ms_svc
PGPASSWORD=cambia-esto

# Cuenta duena, usada SOLO por scripts/bootstrap-db.sh para crear el rol y
# aplicar la migracion aditiva de `formato`. El servicio en ejecucion
# nunca la usa.
PGADMIN_USER=libreria
PGADMIN_PASSWORD=libreria_segura

# --- Servicio ------------------------------------------------------------
LIBROS_ENDPOINT_PUBLICO=https://libros.maxthecoder.online
LOG_LEVEL=INFO

# Paginacion por defecto de /books (la app Electron pide 8 por pagina).
LIMITE_PAGINACION_DEFECTO=8
LIMITE_PAGINACION_MAXIMO=50
